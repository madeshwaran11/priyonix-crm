# ==========================================
# PRIYONIX CRM - BACKEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to backend/.env and fill in real values.
# On Render, set these as Environment Variables in the dashboard.
# ==========================================

# ------------------------------------------
# MySQL database (local development)
# ------------------------------------------
DB_USERNAME=root
DB_PASSWORD=change-me

# ------------------------------------------
# Supabase PostgreSQL (production profile)
# ------------------------------------------
SUPABASE_DB_PASSWORD=change-me

# ------------------------------------------
# Email delivery
# ------------------------------------------
# auto   -> Resend when RESEND_API_KEY is set, else Gmail SMTP
# smtp   -> Gmail SMTP only (local development)
# resend -> Resend HTTPS API only (required on Render,
#           because Render blocks outbound SMTP 25/465/587)
MAIL_PROVIDER=auto

# Gmail SMTP (local development only)
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Resend API (production / Render)
RESEND_API_KEY=
# Must be a verified sender. For quick testing you can use:
# MAIL_FROM=PriyoniX CRM <onboarding@resend.dev>
MAIL_FROM=

# Base URL of the frontend, used to build password reset links.
# Local development:
FRONTEND_BASE_URL=http://localhost:5173
# On Render set this to the deployed frontend, for example:
# FRONTEND_BASE_URL=https://priyonix-crm.vercel.app
